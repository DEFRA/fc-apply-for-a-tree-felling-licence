@using Forestry.Flo.Services.Common.Extensions
@using Forestry.Flo.Services.Common;
@using Forestry.Flo.Services.Common.Infrastructure
@using Forestry.Flo.Services.Common.Models
@model Forestry.Flo.External.Web.Models.FellingLicenceApplication.ActivityFeedViewModel;


<div class="govuk-form-group" id="activity-feed">
    <h2 class="govuk-heading-m">@Model.ActivityFeedTitle</h2>

    <div class="moj-timeline">
        @foreach (var activityFeedItem in Model.ActivityFeedItemModels)
        {
            ActivityFeedItemCategory activityFeedItemCategory = activityFeedItem.ActivityFeedItemType.GetActivityFeedItemTypeAttribute().Value;
            switch (activityFeedItemCategory)
            {
                case ActivityFeedItemCategory.CaseNote:
                    <div class="moj-timeline__item flo-timeline_item-casenote govuk-!-margin-bottom-0" data-type="@activityFeedItem.ActivityFeedItemType.ToString()" data-category="@activityFeedItemCategory">

                        <div class="moj-timeline__header govuk-!-margin-bottom-0">
                            <button class="activity-avatar-button" type="button" hidden="true" aria-hidden="true">
                                <img class="activity-avatar govuk-!-margin-bottom-0" data-forename="@activityFeedItem.CreatedByUser?.FirstName" data-surname="@activityFeedItem.CreatedByUser?.LastName" data-role="@activityFeedItem.CreatedByUser?.AccountType" alt="Avatar">
                            </button>
                            <h2 class="moj-timeline__title">@activityFeedItem.ActivityFeedItemType.GetDisplayName()</h2>

                            <p class="moj-timeline__byline">by @activityFeedItem.CreatedByUser?.FullName</p>

                        </div>

                        <p class="moj-timeline__date govuk-!-margin-bottom-0">
                            @DateTimeDisplay.GetDateTimeDisplayString(activityFeedItem.CreatedTimestamp)
                        </p>

                        <div class="moj-timeline__description govuk-!-margin-bottom-0">
                            <p class="show-line-breaks wrapped-text word-break">@activityFeedItem.Text</p>
                        </div>

                    </div>

                    break;

                case ActivityFeedItemCategory.Notification:
                    switch (activityFeedItem.ActivityFeedItemType)
                    {
                        @*consultee comment formatted same as public register comment*@
                        case ActivityFeedItemType.ConsulteeComment:
                        case ActivityFeedItemType.PublicRegisterComment:
                            <div class="moj-timeline__item govuk-!-margin-bottom-0" data-type="@activityFeedItem.ActivityFeedItemType.ToString()" data-category="@activityFeedItemCategory">

                                <div class="moj-timeline__header govuk-!-margin-bottom-0">
                                    <h2 class="moj-timeline__title">@activityFeedItem.ActivityFeedItemType.GetDisplayName()</h2>

                                    <p class="moj-timeline__byline"> from @activityFeedItem.Source</p>

                                </div>

                                <p class="moj-timeline__date govuk-!-margin-bottom-0">
                                    @DateTimeDisplay.GetDateTimeDisplayString(activityFeedItem.CreatedTimestamp)
                                </p>

                                <div class="moj-timeline__description govuk-!-margin-bottom-0">
                                    <p class="show-line-breaks wrapped-text word-break">@activityFeedItem.Text</p>
                                </div>

                                @if (activityFeedItem.Attachments?.Any() ?? false)
                                {
                                    <div class="govuk-!-margin-bottom-0">
                                        <h3 class="govuk-heading-s">Attachments</h3>
                                        <ul class="govuk-list--bullet">
                                            @foreach (var attachment in activityFeedItem.Attachments)
                                            {
                                                <li>
                                                    <a class="govuk-link" asp-controller="FellingLicenceApplication" asp-action="DownloadSupportingDocument" asp-route-applicationId="@activityFeedItem.FellingLicenceApplicationId" asp-route-documentIdentifier="@attachment.Key">
                                                        @attachment.Value
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                            </div>
                            break;
                        default:
                            <div class="moj-timeline__item govuk-!-margin-bottom-0" data-type="@activityFeedItem.ActivityFeedItemType.ToString()" data-category="@activityFeedItemCategory">

                                <div class="moj-timeline__header govuk-!-margin-bottom-0">
                                    <h2 class="moj-timeline__title">@activityFeedItem.Text</h2>
                                </div>

                                <p class="moj-timeline__date govuk-!-margin-bottom-0">
                                    @DateTimeDisplay.GetDateTimeDisplayString(activityFeedItem.CreatedTimestamp)
                                </p>

                            </div>
                            break;
                    }
                    break;

                case ActivityFeedItemCategory.AmendmentReviews:
                    <div class="moj-timeline__item flo-timeline_item-casenote govuk-!-margin-bottom-0" data-type="@activityFeedItem.ActivityFeedItemType.ToString()" data-category="@activityFeedItemCategory">

                        <div class="moj-timeline__header govuk-!-margin-bottom-0">
                            <button class="activity-avatar-button" type="button" hidden="true" aria-hidden="true">
                                <img class="activity-avatar govuk-!-margin-bottom-0" data-forename="@activityFeedItem.CreatedByUser?.FirstName" data-surname="@activityFeedItem.CreatedByUser?.LastName" data-role="@activityFeedItem.CreatedByUser?.AccountType" alt="Avatar">
                            </button>
                            <h2 class="moj-timeline__title">@activityFeedItem.ActivityFeedItemType.GetDisplayName()</h2>

                            <p class="moj-timeline__byline">by @activityFeedItem.CreatedByUser?.FullName</p>

                        </div>

                        <p class="moj-timeline__date govuk-!-margin-bottom-0">
                            @DateTimeDisplay.GetDateTimeDisplayString(activityFeedItem.CreatedTimestamp)
                        </p>

                        <div class="moj-timeline__description govuk-!-margin-bottom-0">
                            <p class="show-line-breaks wrapped-text word-break">@activityFeedItem.Text</p>
                        </div>

                    </div>

                    break;
            }
        }

        <div style="display: none" id="empty-activity-feed-item">
            <h2 id="empty-activity-feed-text" class="moj-timeline__title no-activity-items">No activity to display.</h2>
        </div>
    </div>
</div>

@section Css{
    <link rel="stylesheet" href="~/css/activity-feed-filters.css" aria-busyasp-append-version="true" />
}