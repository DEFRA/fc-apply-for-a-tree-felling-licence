@using Forestry.Flo.External.Web.Infrastructure
@{
    ViewData["Title"] = "Get help";
    ViewData.ShowBackLink(BackLinkType.Close);
}

<div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">@ViewData["Title"]</h1>

    <p class="govuk-body">
        This is a new service and we're still adding features. Your <a target="_blank" rel="noreferrer noopener" class="govuk-link" href="https://forms.office.com/e/3jqkczV1Am">feedback</a> will help us improve it.
    </p>

    <p class="govuk-body">Contact us if:</p>

    <ul class="govuk-list govuk-list--bullet">
        <li>you need a paper application form (for example, if you cannot access the internet)</li>
        <li>you have a disability or condition that makes it hard to use the online service</li>
        <li>you need help using the service</li>
    </ul>

    <partial name="Partials/_Contact"/>

</div>