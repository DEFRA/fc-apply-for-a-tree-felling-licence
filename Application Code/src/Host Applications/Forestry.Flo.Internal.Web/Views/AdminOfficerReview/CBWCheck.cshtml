@{
    ViewData["Title"] = "Cricket Bat Willow check";

    var user = new InternalUser(User);
}
@model Forestry.Flo.Internal.Web.Models.AdminOfficerReview.CBWCheckModel

<div class="govuk-grid-column-full govuk-body">

    <partial name="Partials/_ConfirmationMessageDisplay" />
    <partial name="Partials/_UserGuideDisplay" />

    <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

    <div class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title"
         data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                Information
            </h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">
                System checks suggest this application may qualify for the expedited cricket bat willow process because the:
                <ul>
                    <li>tree species is cricket bat willow only</li>
                    <li>the felling operation type is clear felling or felling of individual trees</li>
                    <li>restocking replaces what is being felled (like-for-like)</li>
                    <li>felling and restocking individual trees: restocking count equals felling count</li>
                </ul>
            </p>
        </div>
    </div>

    <form id="admin-officer-review" method="post">
        <input asp-for="ApplicationId" />

        <govuk-form-group asp-for="CheckPassed">
            <fieldset class="govuk-fieldset" aria-describedby="expedited-hint">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m no-margin-bottom">
                    <h2 class="govuk-fieldset__heading">
                        Should a Woodland Officer review this application before it is passed to an approver?
                    </h2>
                    <div id="expedited-hint" class="govuk-hint">
                        Use the internal guidance to assess whether the application meets the required criteria for fast-tracked CBW approval. Applications that do not require woodland officer review can be passed to an approver.
                    </div>
                </legend>
                <div class="govuk-radios" data-module="govuk-radios">
                    <div class="govuk-radios" data-module="govuk-radios">
                        <validation asp-for="CheckPassed"></validation>
                        <div class="govuk-radios__item">
                            <input condition-disabled="@(!Model.Editable(user))" class="govuk-radios__input" asp-for="CheckPassed" type="radio" value="true" aria-describedby="yes-radio-hint" />
                            <label class="govuk-label govuk-radios__label" asp-for="CheckPassed">
                                Yes
                            </label>
                            <div id="yes-radio-hint" class="govuk-hint govuk-radios__hint">
                                The application must be reviewed by a woodland officer
                            </div>
                        </div>
                        <div class="govuk-radios__item">
                            <input condition-disabled="@(!Model.Editable(user))" class="govuk-radios__input" id="check-failed" asp-for="CheckPassed" type="radio" value="false" aria-describedby="no-radio-hint" />
                            <label class="govuk-label govuk-radios__label" for="check-failed">
                                No
                            </label>
                            <div id="no-radio-hint" class="govuk-hint govuk-radios__hint">
                                This application can be assigned to an approver
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </govuk-form-group>

        @Html.EditorFor(m => m.FormLevelCaseNote)

        <div>

            <button condition="@Model.Editable(user)" type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>

            <a class="govuk-button govuk-button--secondary" asp-action="Index" asp-route-id="@Model.ApplicationId" title="Back to admin officer review">Back to Admin Officer Review</a>

        </div>
    </form>
</div>
