@using Forestry.Flo.Services.Common
@model Forestry.Flo.Internal.Web.Models.ExternalConsulteeInvite.ReceivedConsulteeCommentsViewModel

@{
    ViewData["Title"] = "Consultation email sent";
}

<partial name="Partials/_FellingLicenceApplicationSummary" model="@Model.FellingLicenceApplicationSummary"/>

<div class="govuk-grid-column-two-thirds width-limit-override">
    <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    
    <div class="govuk-body govuk-!-padding-bottom-3">
        <p>Invitation type: @Model.InvitationPurpose</p>
        <p>Sent on: @DateTimeDisplay.GetDateDisplayString(Model.InvitationDate)</p>
        <p>Exemption status: @(Model.PublicRegisterExempt ? "Exempt" : "Not exempt")</p>
        <p condition="@Model.PublicRegisterExempt">
            Exemption reason: @Model.PublicRegisterExemptionReason ?? "No reason provided"
        </p>
    </div>
    
    <div class="govuk-body govuk-!-padding-bottom-3">
        <p>This page shows the content of the consultation invitation email that was sent.</p>
        <p>Any supporting documents are included in the "Have your say" page linked in the email.</p>
    </div>
    
    <h2 class="govuk-heading-m">Consultee information</h2>
    <div class="govuk-body govuk-!-padding-bottom-3">
        <p>Full name: @Model.ConsulteeName</p>
        <p>Email address: @Model.Email</p>
        <p>Consultation purpose: @Model.InvitationPurpose</p>
    </div>
    
    <h2 class="govuk-heading-m">Email message</h2>
    <div class="govuk-body govuk-!-padding-bottom-3">
        <p>Subject: Felling licence application @Model.FellingLicenceApplicationSummary?.ApplicationReference: consultation request</p>
        <p>
            <span style="white-space: pre-line">@Model.InviteContent</span>
        </p>
    </div>
    
    <h2 class="govuk-heading-m">Supporting documents</h2>
    <div class="govuk-body govuk-!-padding-bottom-5">
        @if (Model.SharedDocuments.Count == 0)
        {
            <div class="govuk-body govuk-!-padding-bottom-5">
                <p>No documents were shared with the consultee.</p>
            </div>
        }
        else
        {
            @foreach (var document in Model.SharedDocuments)
            {
                <p>
                    <a class="govuk-link" asp-controller="SupportingDocuments" asp-action="GetDocument" asp-route-id="@Model.ApplicationId" asp-route-documentIdentifier="@document.Id">
                        @document.FileName
                    </a>
                </p>
            }
        }
    </div>
    
    <h2 class="govuk-heading-m">Responses</h2>
    @if (!Model.ReceivedComments.Any())
    {
        <div class="govuk-body govuk-!-padding-bottom-3">
            <p>No comments have been received yet.</p>
        </div>
    }

    @foreach (var comment in Model.ReceivedComments)
    {
        <div class="govuk-body govuk-!-padding-bottom-3">
            <h3 class="govuk-heading-s">@comment.AuthorName on @DateTimeDisplay.GetDateDisplayString(comment.CreatedTimestamp)</h3>
            <p>@comment.Comment</p>
            @if (comment.Attachments.Any())
            {
                <div>
                    <h4 class="govuk-heading-s">Attachments</h4>
                    <ul class="govuk-list--bullet">
                        @foreach (var attachment in comment.Attachments)
                        {
                            <li>
                                <a class="govuk-link" asp-controller="SupportingDocuments" asp-action="GetDocument" asp-route-id="@Model.ApplicationId" asp-route-documentIdentifier="@attachment.Key">
                                    @attachment.Value
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    
    <div>
        <a asp-action="Index" asp-route-id="@Model.ApplicationId" class="govuk-link">Back to consultation task</a>
    </div>

</div>

@section breadcrumbs
{
    <partial name="Partials/_BreadcrumbsMenu" model="@Model.Breadcrumbs"/>
}