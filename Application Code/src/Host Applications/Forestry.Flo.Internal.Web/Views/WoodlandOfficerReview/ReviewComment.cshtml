@using System.Text.Json
@using Forestry.Flo.Services.Common
@using Forestry.Flo.Services.Gis.Models.Esri.Responses.PublicRegister

@{
    ViewData["Title"] = "Comment received";

    var name = Model.Comment?.Source ?? "Name not provided";
    string? organisation = null;
    string? email = null;

    try
    {
        var esriComment = JsonSerializer.Deserialize<EsriCaseComments>(Model.Comment.Source);

        name = $"{esriComment?.Firstname} {esriComment?.Surname}".Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            name = "Name not provided";
        }
        
        organisation = string.IsNullOrWhiteSpace(esriComment?.Organisation) ? null : esriComment.Organisation;
        email = string.IsNullOrWhiteSpace(esriComment?.EmailAddress) ? null : esriComment.EmailAddress;
    }
    catch
    {
        // no-op - if the source isn't in the expected format, we'll just display the source as a string
    }
    
}

@model Forestry.Flo.Internal.Web.Models.WoodlandOfficerReview.ReviewCommentModel

@{
    var user = new InternalUser(User);
}

<div class="govuk-grid-column-full">
    
    <partial name="Partials/_ConfirmationMessageDisplay"/>
    <partial name="Partials/_UserGuideDisplay"/>

    <h1 class="govuk-heading-m">@ViewData["Title"]</h1>

    <form method="post"
          asp-action="ReviewComment"
          asp-route-id="@Model.ApplicationId"
          asp-route-commentId="@Model.Comment.Id">

        <input asp-for="ApplicationId"/>
		<div class="govuk-form-group">
            <fieldset class="govuk-fieldset" aria-describedby="exempt-hint">
                <div class="govuk-form-group">
                    <p class="govuk-body">
                        @DateTimeDisplay.GetDateDisplayString(Model.Comment.CreatedTimestamp) <br />
                        <a class="govuk-link" href="@Model.CommentDeepLink" target="_blank" rel="noreferrer noopener">
                            View all comments on the consultation public register (opens in new tab)
                        </a>
                    </p>
                    
                    <p class="govuk-body">Comment from: @name</p>
                    <p class="govuk-body" condition="@(!string.IsNullOrWhiteSpace(organisation))">Organisation: @organisation</p>
                    <p class="govuk-body" condition="@(!string.IsNullOrWhiteSpace(email))">Email: @email</p>
                    <br/>

                    <p class="govuk-body">
                        @Model.Comment.Text
                    </p>
                </div>
            </fieldset>
            </div>
        @if (Model.Comment.Reviewed)
        {
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" aria-describedby="exempt-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">
                            Responses
                        </h2>
                    </legend>
                    <div id="exempt-hint" class="govuk-body">
                        @Model.Comment.LastUpdatedUser <br />
                        @DateTimeDisplay.GetDateTimeDisplayString(Model.Comment.LastUpdatedDate, " at ")
                    </div>
                    <div class="govuk-form-group">
                        <p class="govuk-body">
                            @Model.Comment.Response
                        </p>
                    </div>

                </fieldset>
            </div>
            <div class="govuk-button-group" id="back-link-no-forms">
                <a class="govuk-button" asp-action="PublicRegister" asp-route-id="@Model.ApplicationId">Close</a>
            </div>
        }
        else
        {
            <govuk-form-group asp-for="Comment.Response">
                <fieldset class="govuk-fieldset" aria-describedby="exempt-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">
                            Respond to this comment
                        </h2>
                    </legend>
                    <div id="exempt-hint" class="govuk-hint">
                        Your response will be saved to this FLA.
                    </div>
                    <div class="govuk-form-group">
                        <validation asp-for="Comment.Response"></validation>
                        <textarea class="govuk-textarea" rows="4" asp-for="Comment.Response"></textarea>
                    </div>
                </fieldset>
            </govuk-form-group>

            <govuk-form-group asp-for="Comment.Reviewed">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">
                            Mark this comment as reviewed
                        </h2>
                    </legend>
                    <div id="contact-hint" class="govuk-hint">
                        Check this box once you have reviewed the public register comment
                    </div>
                    <validation asp-for="Comment.Reviewed"></validation>
                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" asp-for="Comment.Reviewed" type="checkbox">
                            <label class="govuk-label govuk-checkboxes__label" asp-for="Comment.Reviewed">
                                I have reviewed the comment
                            </label>
                        </div>
                    </div>
                </fieldset>
            </govuk-form-group>

            <div class="govuk-button-group" id="back-link-no-forms">
                <button id="save-response-btn" class="govuk-button" data-module="govuk-button" type="submit">Save response</button>
            </div>
        }
    </form>

</div>

@section Scripts
{
    <script src="~/js/public-register.js" asp-append-version="true"></script>
}

@section breadcrumbs
{
    <partial name="Partials/_BreadcrumbsMenu" model="@Model.Breadcrumbs" />
}